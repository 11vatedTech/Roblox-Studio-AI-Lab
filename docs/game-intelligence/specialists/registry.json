{
  "schemaVersion": 1,
  "title": "AI Roblox Studio Lab specialist capability registry",
  "purpose": "Maps the existing role contracts to stable capabilities, artifact handoffs, bounded operation classes, and independent reviewers. Entries are callable responsibilities; they do not launch agents or grant Studio, account, publishing, upload, or production-data permissions.",
  "reviewedAt": "2026-11-07",
  "divisions": [
    "Game Intelligence",
    "Creative Production",
    "Engineering",
    "Quality & Verification",
    "Product & Operations"
  ],
  "allowedOperationClasses": [
    "read-knowledge",
    "read-project-source",
    "read-local-documents",
    "read-official-documentation",
    "research-public-information",
    "read-studio-datamodel",
    "inspect-local-assets",
    "write-design-documents",
    "write-project-source",
    "write-local-assets",
    "run-local-checks",
    "build-rojo-project",
    "capture-studio-evidence",
    "write-evidence-records",
    "review-artifacts",
    "profile-target-devices",
    "propose-task-graph",
    "write-analytics-plan",
    "write-release-plan"
  ],
  "forbiddenOperationClasses": [
    "publish-experience",
    "upload-asset",
    "purchase-asset",
    "enable-open-cloud",
    "write-production-data",
    "change-account-permissions",
    "arbitrary-process-execution",
    "arbitrary-file-access",
    "arbitrary-mcp-invocation"
  ],
  "humanApprovalRequirements": [
    {
      "id": "hero-artistic-acceptance",
      "requirement": "Hero assets require explicit human visual approval after independent visual review; automated checks and AI analysis are supporting evidence only."
    },
    {
      "id": "hero-asset-acceptance",
      "requirement": "Hero characters, creatures, signature weapons, landmarks, and other defining assets require named human visual sign-off before acceptance."
    },
    {
      "id": "hero-animation-acceptance",
      "requirement": "Hero character and creature animation requires human visual review and sign-off after gameplay integration."
    },
    {
      "id": "final-art-direction",
      "requirement": "Final art direction requires explicit human approval against the approved visual identity and acceptance rubric."
    },
    {
      "id": "license-exception",
      "requirement": "Any license exception requires human review of the source and permitted use before asset integration."
    },
    {
      "id": "external-or-live-operation",
      "requirement": "Asset uploads, purchases, publishing, account permission changes, paid services, and production data writes require separate user authorization for the specific operation."
    },
    {
      "id": "live-operations",
      "requirement": "Live-operations changes require human review of player impact, timing, rollback, and service permissions."
    },
    {
      "id": "player-data-collection",
      "requirement": "Player-data collection requires human approval of the specific data, purpose, retention, and privacy boundary."
    },
    {
      "id": "monetization",
      "requirement": "Monetization changes require explicit human approval; no purchase, paid random reward, or monetization setting may be changed by a specialist."
    },
    {
      "id": "release-publication",
      "requirement": "Publication requires explicit human authorization for the exact experience and release."
    },
    {
      "id": "release-certification",
      "requirement": "Final art direction and release certification require explicit human sign-off with evidence."
    }
  ],
