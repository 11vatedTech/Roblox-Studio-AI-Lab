{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:11vatedtech:roblox-lab:specialist:v1",
  "title": "Roblox Lab Specialist Registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "division",
    "contractPath",
    "capabilityIds",
    "inputArtifactTypes",
    "outputArtifactTypes",
    "permittedOperationClasses",
    "independentReviewerIds"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^specialist\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "division": {
      "enum": [
        "Game Intelligence",
        "Creative Production",
        "Engineering",
        "Quality & Verification",
        "Product & Operations"
      ]
    },
    "contractPath": { "type": "string", "pattern": "^skills/roles/[a-z0-9-]+\\.md$" },
    "capabilityIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(engine|genre|mechanic|style|animation|product|production|failure)\\.[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "inputArtifactTypes": { "$ref": "#/$defs/artifactTypes" },
    "outputArtifactTypes": { "$ref": "#/$defs/artifactTypes" },
    "permittedOperationClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
    },
    "independentReviewerIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^specialist\\.[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "humanApprovalRequiredFor": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
    }
  },
  "$defs": {
    "artifactTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
    }
  }
}
