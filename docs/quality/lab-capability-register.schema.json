{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab-capability-register.schema.json",
  "title": "11vatedTech Lab Capability Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "status": {
      "enum": ["NOT_STARTED", "IN_PROGRESS", "IMPLEMENTED", "VERIFIED", "BLOCKED_EXTERNAL", "BLOCKED_HUMAN_APPROVAL", "FAILED", "DEFERRED_WITH_JUSTIFICATION"]
    },
    "pathList": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "dependencyIds", "implementationPaths", "acceptanceCriteria", "verificationMethod", "verificationResult", "evidenceRefs", "outstandingDefects", "blockers", "approvalRequirements"],
      "properties": {
        "id": { "type": "string", "pattern": "^LAB-[A-Z0-9]+-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "$ref": "#/$defs/status" },
        "dependencyIds": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^LAB-[A-Z0-9]+-[0-9]{3}$" }, "uniqueItems": true },
        "implementationPaths": { "$ref": "#/$defs/pathList", "minItems": 1 },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "verificationMethod": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "verificationResult": { "enum": ["passed", "failed", "blocked", "not_run", "unverified"] },
        "evidenceRefs": { "$ref": "#/$defs/pathList" },
        "outstandingDefects": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "description"],
            "properties": {
              "severity": { "enum": ["critical", "high", "medium", "low"] },
              "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "blockers": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "approvalRequirements": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "VERIFIED" } } },
          "then": { "properties": { "verificationResult": { "const": "passed" }, "evidenceRefs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["BLOCKED_EXTERNAL", "BLOCKED_HUMAN_APPROVAL", "DEFERRED_WITH_JUSTIFICATION"] } } },
          "then": { "properties": { "blockers": { "minItems": 1 } } }
        }
      ]
    }
  }
}
