{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-registry.schema.json",
  "title": "11vatedTech Lab Evidence Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "status", "title", "capturedAt", "project", "scope", "reference", "referenceSha256", "limitations"],
        "properties": {
          "id": { "type": "string", "pattern": "^evidence\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$" },
          "type": { "enum": ["studio-session", "task-execution", "verification-run", "asset-build", "security-review", "performance-profile", "visual-review", "research"] },
          "status": { "enum": ["passed", "failed", "blocked", "unverified"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 180 },
          "capturedAt": { "type": "string", "format": "date-time" },
          "project": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$" },
          "scope": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "reference": { "type": "string", "pattern": "^evidence/(?!.*(?:^|/)\\.\\.?/)[^\\\\]+$" },
          "referenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "limitations": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
        }
      }
    }
  }
}
