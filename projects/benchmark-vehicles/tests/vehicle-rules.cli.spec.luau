local Rules = require("../src/shared/VehicleRules")

local input = assert(Rules.validateInput({ throttle = 0.75, steer = -0.25 }, 0, 0.2, 0.1))
assert(input.throttle == 0.75 and input.steer == -0.25, "bounded vehicle intent is retained")
local malformed, malformedReason = Rules.validateInput({ throttle = 1, steer = 0, speed = 1000 }, 0, 1, 0.1)
assert(malformed == nil and malformedReason == "unknown_field", "unrecognized client control data is rejected")
local overdrive, overdriveReason = Rules.validateInput({ throttle = 2, steer = 0 }, 0, 1, 0.1)
assert(overdrive == nil and overdriveReason == "out_of_bounds", "overdrive input is rejected")
local rapid, rapidReason = Rules.validateInput({ throttle = 1, steer = 0 }, 1, 1.02, 0.1)
assert(rapid == nil and rapidReason == "rate_limited", "rapid control packets are rejected")
assert(not Rules.shouldRecover(8, 0, 10, 5), "vehicle within bounds does not recover")
assert(Rules.shouldRecover(12, 0, 10, 5), "vehicle off course is returned to a safe start")
assert(Rules.shouldRecover(0, 5, 10, 5), "stuck vehicle receives bounded recovery")
print("PASS vehicle controls, rate limit, and off-course recovery")
